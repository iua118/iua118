{
  "info": {
    "name": "CRM System API",
    "description": "Complete CRM API testing collection",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123456\",\n  \"firstName\": \"Nguyễn\",\n  \"lastName\": \"Văn A\",\n  \"phone\": \"0912345678\",\n  \"department\": \"Sales\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123456\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Get All Leads",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Leads - Filter Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads?status=NEW",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Leads - Filter Source",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads?source=WEBSITE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Leads - Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads?search=Tôn",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Lead Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads/{{lead_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/leads",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Tôn\",\n  \"lastName\": \"Nữ Tây\",\n  \"email\": \"ton.nuytay@techcorp.com\",\n  \"phone\": \"0912345678\",\n  \"company\": \"Tech Solutions Inc\",\n  \"jobTitle\": \"CTO\",\n  \"source\": \"WEBSITE\",\n  \"notes\": \"Khách hàng tiềm năng cao, budget lớn\",\n  \"tags\": [\"VIP\", \"Hot\", \"B2B\"]\n}"
            }
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/leads/{{lead_id}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobTitle\": \"VP Engineering\",\n  \"notes\": \"Updated: Rất hứa hẹn\"\n}"
            }
          }
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/leads/{{lead_id}}/status",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONTACTED\"\n}"
            }
          }
        },
        {
          "name": "Update Lead Score",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/leads/{{lead_id}}/score",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 85\n}"
            }
          }
        },
        {
          "name": "Assign Lead",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/leads/{{lead_id}}/assign",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/leads/{{lead_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Lead Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads/stats/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Leads By Source",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/leads/stats/by-source",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
