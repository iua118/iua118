// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Users & Auth ====================
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole   @default(USER)
  department    String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  leads         Lead[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  sequences     AutomationSequence[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ==================== Leads ====================
model Lead {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  jobTitle        String?
  source          LeadSource
  status          LeadStatus    @default(NEW)
  stage           String?
  score           Int           @default(0)
  notes           String?
  tags            String[]
  customFields    Json?
  assignedToId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
  contact         Contact?
  deal            Deal?
  activities      Activity[]
  sequenceSteps   AutomationSequenceStep[]

  @@map("leads")
}

enum LeadSource {
  WEBSITE
  FACEBOOK_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  REFERRAL
  MANUAL
  LANDING_PAGE
  API
  EMAIL
  CALL
  LINKEDIN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  NURTURING
  CONVERTED
  LOST
}

// ==================== Contacts ====================
model Contact {
  id              String        @id @default(cuid())
  leadId          String?       @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  jobTitle        String?
  department      String?
  accountId       String?
  role            ContactRole   @default(USER)
  status          ContactStatus @default(ACTIVE)
  notes           String?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  account         Account?      @relation(fields: [accountId], references: [id])
  activities      Activity[]
  dealContacts    DealContact[]

  @@map("contacts")
}

enum ContactRole {
  DECISION_MAKER
  INFLUENCER
  USER
  CHAMPION
  BLOCKER
  ECONOMIC_BUYER
  OTHER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ==================== Accounts ====================
model Account {
  id              String        @id @default(cuid())
  name            String
  industry        String?
  website         String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  annualRevenue   BigInt?
  numberOfEmployees Int?
  type            AccountType   @default(PROSPECT)
  status          AccountStatus @default(ACTIVE)
  customFields    Json?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]

  @@map("accounts")
}

enum AccountType {
  PROSPECT
  CUSTOMER
  PARTNER
  COMPETITOR
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ==================== Deals ====================
model Deal {
  id              String        @id @default(cuid())
  name            String
  description     String?
  leadId          String?       @unique
  accountId       String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  stage           DealStage     @default(PROSPECTING)
  probability     Int           @default(0)
  expectedCloseDate DateTime?
  actualCloseDate DateTime?
  status          DealStatus    @default(OPEN)
  assignedToId    String
  notes           String?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  account         Account?      @relation(fields: [accountId], references: [id])
  assignedTo      User          @relation(fields: [assignedToId], references: [id])
  contacts        DealContact[]
  activities      Activity[]
  meetings        Meeting[]
  emails          Email[]
  calls           Call[]
  tasks           Task[]

  @@map("deals")
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSING
  WON
  LOST
}

enum DealStatus {
  OPEN
  CLOSED_WON
  CLOSED_LOST
  STALLED
}

// ==================== Deal Contacts (Many-to-Many) ====================
model DealContact {
  dealId          String
  contactId       String
  role            String?
  influence       String?       @default("NORMAL")
  createdAt       DateTime      @default(now())

  // Relations
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@map("deal_contacts")
}

// ==================== Tasks ====================
model Task {
  id              String        @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus    @default(OPEN)
  priority        TaskPriority  @default(MEDIUM)
  dueDate         DateTime?
  dealId          String?
  leadId          String?
  accountId       String?
  assignedToId    String
  createdById     String
  completedAt     DateTime?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  assignedTo      User          @relation(fields: [assignedToId], references: [id])
  createdBy       User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  subtasks        Subtask[]

  @@map("tasks")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== Subtasks ====================
model Subtask {
  id              String        @id @default(cuid())
  taskId          String
  title           String
  status          TaskStatus    @default(OPEN)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

// ==================== Communication: Emails ====================
model Email {
  id              String        @id @default(cuid())
  subject         String
  body            String
  from            String
  to              String[]
  cc              String[]
  bcc             String[]
  dealId          String?
  contactId       String?
  status          EmailStatus   @default(SENT)
  openedAt        DateTime?
  clickedAt       DateTime?
  bounced         Boolean       @default(false)
  templateId      String?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template        EmailTemplate? @relation(fields: [templateId], references: [id])

  @@map("emails")
}

enum EmailStatus {
  DRAFT
  SCHEDULED
  SENT
  BOUNCED
  FAILED
}

// ==================== Email Templates ====================
model EmailTemplate {
  id              String        @id @default(cuid())
  name            String
  subject         String
  body            String
  category        String?
  tags            String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  emails          Email[]

  @@map("email_templates")
}

// ==================== Communication: Calls ====================
model Call {
  id              String        @id @default(cuid())
  dealId          String?
  contactId       String?
  type            CallType      @default(OUTBOUND)
  status          CallStatus    @default(COMPLETED)
  duration        Int?          // in seconds
  notes           String?
  recordingUrl    String?
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("calls")
}

enum CallType {
  INBOUND
  OUTBOUND
  MISSED
}

enum CallStatus {
  PENDING
  COMPLETED
  NO_ANSWER
  VOICEMAIL
}

// ==================== Communication: Meetings ====================
model Meeting {
  id              String        @id @default(cuid())
  title           String
  description     String?
  dealId          String?
  startTime       DateTime
  endTime         DateTime
  location        String?
  meetingUrl      String?
  platform        MeetingPlatform?
  notes           String?
  attendees       String[]
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@map("meetings")
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  WEBEX
  OTHER
}

// ==================== Activities ====================
model Activity {
  id              String        @id @default(cuid())
  type            ActivityType
  description     String
  userId          String?
  leadId          String?
  dealId          String?
  contactId       String?
  accountId       String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  // Relations
  user            User?         @relation(fields: [userId], references: [id])
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account         Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONVERTED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_CLOSED
  CONTACT_CREATED
  CONTACT_UPDATED
  EMAIL_SENT
  EMAIL_OPENED
  CALL_MADE
  MEETING_SCHEDULED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  CUSTOM
}

// ==================== Automation ====================
model AutomationSequence {
  id              String        @id @default(cuid())
  name            String
  description     String?
  trigger         AutomationTrigger
  triggerConfig   Json
  status          AutomationStatus @default(ACTIVE)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  createdBy       User          @relation(fields: [createdById], references: [id])
  steps           AutomationSequenceStep[]

  @@map("automation_sequences")
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_QUALIFIED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  CONTACT_ADDED
  TIME_DELAY
  CUSTOM
}

enum AutomationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ==================== Automation Steps ====================
model AutomationSequenceStep {
  id              String        @id @default(cuid())
  sequenceId      String
  order           Int
  action          AutomationAction
  actionConfig    Json
  leadId          String?
  executedAt      DateTime?
  status          StepStatus    @default(PENDING)
  createdAt       DateTime      @default(now())

  // Relations
  sequence        AutomationSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("automation_sequence_steps")
}

enum AutomationAction {
  SEND_EMAIL
  CREATE_TASK
  UPDATE_FIELD
  ASSIGN_TO_USER
  CHANGE_STATUS
  ADD_TO_SEQUENCE
  SEND_NOTIFICATION
  WEBHOOK
  CUSTOM
}

enum StepStatus {
  PENDING
  EXECUTING
  COMPLETED
  FAILED
  SKIPPED
}

// ==================== Reports ====================
model Report {
  id              String        @id @default(cuid())
  name            String
  type            ReportType
  config          Json
  data            Json?
  generatedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("reports")
}

enum ReportType {
  PIPELINE
  FORECAST
  ACTIVITY
  PERFORMANCE
  CUSTOM
}
